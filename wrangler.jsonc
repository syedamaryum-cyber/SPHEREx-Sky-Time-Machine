{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "spherex-sky-time-machine",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "previews": {}
}
